<!doctype html>
<html lang="en">
  <head>

    <%- include('partials/head') %>

    <style>
      .notify-switch {
        position: relative;
        display: inline-block;
        width: 56px;
        height: 28px;
        cursor: pointer;
      }
      .notify-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .notify-slider {
        position: absolute;
        inset: 0;
        background-color: #EAA221;
        border-radius: 36px;
        transition: background-color 0.3s ease;
      }
      .notify-slider:before {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        left: 4px;
        top: 4px;
        background-color: white;
        border-radius: 50%;
        transition: transform 0.3s ease;
      }
      .notify-switch input:checked + .notify-slider {
        background-color: #4CAF50;
      }
      .notify-switch input:checked + .notify-slider:before {
        transform: translateX(28px);
      }
      .notify-switch input:focus + .notify-slider {
        box-shadow: 0 0 0 3px rgba(234, 162, 33, 0.4);
      }

      html, body {
        min-height: 100%;
      }

      body {
        background:
          linear-gradient(#00000080, #000000BF),
          url(/assets/img/bg-img-1.jpg) center/cover no-repeat fixed;
      }
    </style>
  
  </head>
  
  <body>

    <%- include('partials/navbar') %>

<!-- Title -->
  <div class="container" style="margin-top: 50px; margin-bottom: 50px; padding-bottom: 25px; border-bottom: solid 2px;">
    <h1 style="color: #EAA221; text-align: center; text-shadow: 2px 2px 3px black;">
      <%= title %>
    </h1>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>


<div class="container mb-5">
  <div class="card shadow-lg">
    <div class="card-body ps-5 py-5" style="min-height: 450px;">

      <% if (success) { %>
        <div class="alert alert-success">Settings saved successfully.</div>
      <% } %>

      <% if (!isLoggedIn) { %>
        <p class="text-muted">Please <a href="/login">log in</a> to manage your settings.</p>
      <% } else { %>

        <form action="/settings" method="POST">

          <!-- Notification Preference -->
          <div class="mb-4">
            <h5 class="mb-3">Email Notifications</h5>
            <div class="d-flex align-items-center gap-3">
              <label class="notify-switch">
                <input type="checkbox" id="notifyToggle" <%= !user || !user.notify_pantry_only ? 'checked' : '' %>>
                <span class="notify-slider"></span>
              </label>
              <input type="hidden" name="notify_pantry_only" id="notifyPantryOnlyVal" value="<%= user && user.notify_pantry_only ? 'on' : '' %>">
              <div style="margin-left: 1rem;">
                <div id="notifyLabel" style="font-size: 1rem; font-weight: bold; color: <%= !user || !user.notify_pantry_only ? '#4CAF50' : '#EAA221' %>;">
                  <%= !user || !user.notify_pantry_only ? 'All FDA Recalls' : 'My Pantry Only' %>
                </div>
                <div id="notifyDesc" class="small text-muted mt-1">
                  <%= !user || !user.notify_pantry_only ? 'You will be notified about all new FDA food recalls.' : 'You will only be notified about recalls matching your pantry items.' %>
                </div>
              </div>
            </div>
          </div>

          <!-- Region Filter -->
          <div class="mb-4">
            <h5 class="mb-3">Recall Region Filter</h5>
            <p class="text-muted small">Only show recalls affecting your selected state. Leave blank to see all regions.</p>
            <select name="region_filter" class="form-select" style="max-width: 300px;">
              <option value="">All Regions</option>
              <% const states = ['AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY']; %>
              <% states.forEach(state => { %>
                <option value="<%= state %>" <%= user && user.region_filter === state ? 'selected' : '' %>><%= state %></option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="btn btn-primary" style="background-color: #EAA221; border: none; color: black;">Save Settings</button>
        </form>

        <!-- Bottom button -->
        <div class="mt-5">
          <button class="btn btn-danger">Delete Account</button>
        </div>

      <% } %>

    </div>
  </div>
</div>
  <script>
    document.getElementById('notifyToggle').addEventListener('change', function() {
      const label = document.getElementById('notifyLabel');
      const desc = document.getElementById('notifyDesc');
      if (this.checked) {
        label.textContent = 'All FDA Recalls';
        label.style.color = '#4CAF50';
        desc.textContent = 'You will be notified about all new FDA food recalls.';
      } else {
        label.textContent = 'My Pantry Only';
        label.style.color = '#EAA221';
        desc.textContent = 'You will only be notified about recalls matching your pantry items.';
      }
      document.getElementById('notifyPantryOnlyVal').value = this.checked ? '' : 'on';
    });
  </script>
  </body>
</html>