<!doctype html>
<html lang="en">
  <head>

    <%- include('partials/head') %>
  
  </head>
  
  <body style="background: linear-gradient(#00000080, #00000080), url(/assets/img/bg-img-3.jpg) center/cover no-repeat fixed;">

    <%- include('partials/navbar') %>

<div class="container mt-5">
        <h1 style="color: #EAA221;"><%= title %></h1>

        <!-- Data Source Citation -->
        <div class="mb-3 p-3 d-flex justify-content-between align-items-center" style="background-color: #1a1a1a; border-radius: 8px; border-left: 4px solid #EAA221;">
          <div>
            <% if (regionFilter) { %>
              <span class="ms-2 badge" style="background-color: #EAA221; color: black;"><%= regionFilter %> only</span>
              <a href="/settings" class="ms-1 small" style="color: #EAA221;">Change</a>
            <% } %>
            <div id="fdaRefreshResult" class="mt-1 small text-white d-none"></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <select id="fdaDays" class="form-select form-select-sm text-dark" style="width: auto;">
              <option value="30">Past 30 days</option>
              <option value="90">Past 90 days</option>
              <option value="365">Past year</option>
            </select>
            <button id="fdaRefreshBtn" class="btn btn-sm" style="border-color: #EAA221; color: #EAA221;" onclick="refreshFromFDA()">↻ Refresh from FDA</button>
            <button class="btn btn-sm btn-outline-danger" onclick="clearRecalls()">Clear Recalls</button>
          </div>
        </div>

        <!-- Date Filter -->
        <div class="mb-4">
          <div class="btn-group me-3 mb-2" id="datePresets">
            <button class="btn btn-outline-secondary btn-sm" style="color: #EAA221; border-color: #EAA221;" onclick="filterByDays(30, this)">Past Month</button>
            <button class="btn btn-outline-secondary btn-sm" style="color: #EAA221; border-color: #EAA221;" onclick="filterByDays(90, this)">Past 3 Months</button>
            <button class="btn btn-outline-secondary btn-sm" style="color: #EAA221; border-color: #EAA221;" onclick="filterByDays(365, this)">Past Year</button>
            <button class="btn btn-outline-secondary btn-sm" style="color: #EAA221; border-color: #EAA221;" onclick="clearFilter(this)">All</button>
          </div>
          <div class="d-inline-flex align-items-center gap-2 mb-2">
            <input type="date" id="fromDate" class="form-control form-control-sm" style="width: auto;" onchange="filterByRange()">
            <span class="text-muted">to</span>
            <input type="date" id="toDate" class="form-control form-control-sm" style="width: auto;" onchange="filterByRange()">
          </div>
          <% if (isLoggedIn) { %>
            <button id="pantryToggle" class="btn btn-outline-warning btn-sm ms-2 mb-2" onclick="togglePantry()">Show My Pantry Only</button>
          <% } %>
          <span id="filterCount" class="text-muted ms-2 small"></span>
        </div>

        <div id="recallList">
        <% if (!recall_data || recall_data.length === 0) { %>
          <div class="text-center py-5">
            <h4 style="color: #EAA221;">No recalls in database</h4>
            <p class="text-light">Click <strong>↻ Refresh from FDA</strong> above to populate with live FDA recall data.</p>
          </div>
        <% } else { %>
          <% recall_data.forEach(recall => { %>
            <div class="card mb-3" data-recall-date="<%= recall.recall_date || recall.date || '' %>" data-in-pantry="<%= pantryProductIds.includes(recall.product_id) %>">
              <div class="card-header d-flex justify-content-between align-items-center">
                <span>Initiated: <%= recall.recall_date ? new Date(recall.recall_date).toLocaleDateString() : recall.date ? new Date(recall.date).toLocaleDateString() : 'Unknown' %></span>
                <% if (recall.report_date) { %><span class="small text-muted">FDA Report: <%= new Date(recall.report_date).toLocaleDateString() %></span><% } %>
              </div>

              <div class="card-body">
                <h5 class="card-title"><%= recall.company %></h5>
                <h5 class="card-title"><%= recall.product_name || recall.product?.product_name || 'Unknown product' %></h5>
                <h6 class="card-subtitle text-muted"><%= recall.classification %></h6>

                <button class="btn btn-outline-secondary mt-3 mb-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#recallDetails<%= recall.recall_id %>">
                  View Details
                </button>

                <div class="collapse" id="recallDetails<%= recall.recall_id %>">
                  <div class="card-body border-top">
                    <p class="card-text">Reason for Recall: <%= recall.reason_for_recall %></p>
                    <p class="card-text">Regions: <%= recall.regions %></p>
                    <p class="card-text">People Affected: <%= recall.amount_sick %></p>
                    <p class="card-text">Deaths: <%= recall.amount_dead %></p>
                    <% if (recall.report_date) {
                      const rd = new Date(recall.report_date);
                      const month = rd.toLocaleDateString('en-US', {month:'long'}).toLowerCase();
                      const day = rd.getDate();
                      const year = rd.getFullYear();
                    %>
                      <a href="https://www.fda.gov/safety/recalls-market-withdrawals-safety-alerts/enforcement-report-<%= month %>-<%= day %>-<%= year %>" target="_blank" class="btn btn-outline-warning btn-sm mt-2">View on FDA.gov →</a>
                    <% } else { %>
                      <a href="https://www.fda.gov/safety/recalls-market-withdrawals-safety-alerts?search_api_fulltext=<%= encodeURIComponent(recall.company) %>" target="_blank" class="btn btn-outline-warning btn-sm mt-2">View on FDA.gov →</a>
                    <% } %>
                    <br>
                    <% const rawUrl = recall.recall_number
                      ? `https://api.fda.gov/food/enforcement.json?search=recall_number:%22${recall.recall_number}%22`
                      : `https://api.fda.gov/food/enforcement.json?search=recalling_firm:%22${encodeURIComponent(recall.company)}%22&limit=5`; %>
                    <a href="<%= rawUrl %>" target="_blank" class="small mt-1" style="color: #6c757d;">View raw data</a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
        </div><!-- end recallList -->
    </div>

    <script>
      function getCards() {
        return document.querySelectorAll('#recallList .card');
      }

      function setActiveBtn(btn) {
        document.querySelectorAll('#datePresets .btn').forEach(b => {
          b.classList.remove('btn-secondary');
          b.classList.add('btn-outline-secondary');
        });
        if (btn) {
          btn.classList.remove('btn-outline-secondary');
          btn.classList.add('btn-secondary');
        }
      }

      function filterByDays(days, btn) {
        const from = new Date();
        from.setDate(from.getDate() - days);
        setActiveBtn(btn);
        applyFilter(from, new Date());
      }

      function filterByRange() {
        const from = document.getElementById('fromDate').value;
        const to = document.getElementById('toDate').value;
        if (!from && !to) return clearFilter();
        setActiveBtn(null);
        applyFilter(from ? new Date(from) : null, to ? new Date(to) : null);
      }

      function clearFilter(btn) {
        document.getElementById('fromDate').value = '';
        document.getElementById('toDate').value = '';
        setActiveBtn(btn);
        applyFilter(null, null);
      }

      async function clearRecalls() {
        if (!confirm('Are you sure you want to clear all recalls? This action is irreversible.')) return;
        const result = document.getElementById('fdaRefreshResult');
        try {
          const res = await fetch('/recalls/clear', { method: 'POST' });
          const data = await res.json();
          result.textContent = data.success ? `✓ Cleared ${data.deleted} recalls` : `✗ ${data.error}`;
          result.classList.remove('d-none');
          setTimeout(() => location.reload(), 1000);
        } catch {
          result.textContent = '✗ Failed to clear';
          result.classList.remove('d-none');
        }
      }

      async function refreshFromFDA() {
        const btn = document.getElementById('fdaRefreshBtn');
        const result = document.getElementById('fdaRefreshResult');
        const days = document.getElementById('fdaDays').value;
        btn.textContent = '↻ Fetching from FDA...';
        btn.disabled = true;
        try {
          const res = await fetch('/recalls/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ days })
          });
          const data = await res.json();
          result.textContent = data.success
            ? `✓ Added ${data.added} new recall${data.added !== 1 ? 's' : ''} from FDA (past ${data.days} days)`
            : `✗ ${data.error}`;
          result.classList.remove('d-none');
          if (data.success && data.added > 0) setTimeout(() => location.reload(), 1500);
          btn.textContent = '↻ Refresh from FDA';
        } catch {
          btn.textContent = '✗ Failed';
        } finally {
          btn.disabled = false;
        }
      }

      let pantryOnly = false;
      function togglePantry() {
        pantryOnly = !pantryOnly;
        document.getElementById('pantryToggle').textContent = pantryOnly ? 'Show All Recalls' : 'Show My Pantry Only';
        document.getElementById('pantryToggle').classList.toggle('btn-warning', pantryOnly);
        document.getElementById('pantryToggle').classList.toggle('btn-outline-warning', !pantryOnly);
        applyCurrentFilter();
      }

      function applyCurrentFilter() {
        const from = document.getElementById('fromDate').value ? new Date(document.getElementById('fromDate').value) : null;
        const to = document.getElementById('toDate').value ? new Date(document.getElementById('toDate').value) : null;
        applyFilter(from, to);
      }

      function applyFilter(from, to) {
        let visible = 0;
        document.querySelectorAll('#recallList [data-recall-date]').forEach(el => {
          const date = new Date(el.dataset.recallDate);
          const inPantry = el.dataset.inPantry === 'true';
          const show = (!from || date >= from) && (!to || date <= to) && (!pantryOnly || inPantry);
          el.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        document.getElementById('filterCount').textContent = `${visible} recall${visible !== 1 ? 's' : ''} shown`;
      }
    </script>

    <!-- Login Modal -->
    <div class="modal fade"
          id="loginRequiredModal"
          tabindex="-1"
          data-bs-backdrop="static"
          data-bs-keyboard="false">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color:black; --bs-modal-border-color:#EAA221;">

          <div class="modal-header" >
            <h3 class="modal-title" style="color:#EAA221;">Login Required</h3>
          </div>

          <div class="modal-body">
            <p style="color:#EAA221;">You must be logged in to view this page.</p>
          </div>

          <div class="modal-footer">
            <a href="/" class="btn btn-outline-light" style="color:#EAA221; --bs-btn-border-color: #EAA221;">Return Home</a>
            <a href="/login" class="btn btn-warning" style="color: black;">Log In</a>
          </div>

        </div>
      </div>
    </div>

    <% if (!isLoggedIn) { %>
      <script>
        window.onload = function () {
          const modal = new bootstrap.Modal(document.getElementById('loginRequiredModal'));
          modal.show();
        };
      </script>
    <% } %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  
  </body>
</html>